{
  "id": "jfk-tower-go-around",
  "stationId": "jfk-tower",
  "airport": "JFK",
  "audioUrl": "/clips/jfk-tower-go-around/audio.mp3",
  "durationMs": 114000,
  "title": "Kennedy Tower — arrivals and a go-around",
  "description": "A Delta jet has only just touched down when a British Airways 777 arrives too close behind it, so the tower orders the 777 to abort its landing and climb away while a JetBlue departs alongside.",
  "cues": [
    {"id": "c1", "startMs": 800, "endMs": 7102, "text": "Delta four eighteen, Kennedy Tower, wind two three zero at one four, runway two two left, cleared to land.", "callsign": "DAL418", "speaker": "Tower"},
    {"id": "c2", "startMs": 7661, "endMs": 9912, "text": "Cleared to land two two left, Delta four eighteen.", "callsign": "DAL418", "speaker": "Pilot"},
    {"id": "c3", "startMs": 11512, "endMs": 18253, "text": "Speedbird one seven three heavy, Kennedy Tower, number two, following an Airbus on a two mile final, runway two two left, continue.", "callsign": "BAW173", "speaker": "Tower"},
    {"id": "c4", "startMs": 18829, "endMs": 21549, "text": "Continue, number two, Speedbird one seven three heavy.", "callsign": "BAW173", "speaker": "Pilot"},
    {"id": "c5", "startMs": 37549, "endMs": 43242, "text": "JetBlue six fifteen, wind two three zero at one four, runway two two right, cleared for takeoff.", "callsign": "JBU615", "speaker": "Tower"},
    {"id": "c6", "startMs": 43734, "endMs": 46813, "text": "Cleared for takeoff two two right, JetBlue six fifteen.", "callsign": "JBU615", "speaker": "Pilot"},
    {"id": "c7", "startMs": 70450, "endMs": 75115, "text": "Delta four eighteen, turn left at Juliet, contact ground one two one point niner.", "callsign": "DAL418", "speaker": "Tower"},
    {"id": "c8", "startMs": 75659, "endMs": 79477, "text": "Left at Juliet, ground one two one point niner, Delta four eighteen.", "callsign": "DAL418", "speaker": "Pilot"},
    {"id": "c9", "startMs": 80977, "endMs": 87550, "text": "Speedbird one seven three heavy, go around. Traffic still on the runway. Fly runway heading, climb and maintain two thousand.", "callsign": "BAW173", "speaker": "Tower"},
    {"id": "c10", "startMs": 88032, "endMs": 92129, "text": "Going around, runway heading, two thousand, Speedbird one seven three heavy.", "callsign": "BAW173", "speaker": "Pilot"},
    {"id": "c11", "startMs": 93929, "endMs": 97676, "text": "JetBlue six fifteen, contact departure one three five point niner.", "callsign": "JBU615", "speaker": "Tower"},
    {"id": "c12", "startMs": 98200, "endMs": 101509, "text": "One three five point niner, JetBlue six fifteen, see you.", "callsign": "JBU615", "speaker": "Pilot"},
    {"id": "c13", "startMs": 103309, "endMs": 107595, "text": "Speedbird one seven three heavy, contact departure one three five point niner.", "callsign": "BAW173", "speaker": "Tower"},
    {"id": "c14", "startMs": 108131, "endMs": 111290, "text": "One three five point niner, Speedbird one seven three heavy.", "callsign": "BAW173", "speaker": "Pilot"}
  ],
  "aircraft": {
